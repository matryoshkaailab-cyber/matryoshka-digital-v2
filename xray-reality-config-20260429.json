{
  "log": {
    "loglevel": "warning",
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log"
  },
  "inbounds": [
    {
      "tag": "vless-reality-vision",
      "listen": "127.0.0.1",
      "port": 10443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "4ea33e69-8a88-4811-b1f7-e433b46b8f5a",
            "email": "user1@datalink",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.bing.com:443",
          "xver": 0,
          "serverNames": [
            "www.bing.com"
          ],
          "privateKey": "UOW9SYxgPjGBP1HkkUMFFAxs4we-8Q4MEFcbnNAZMlc",
          "shortIds": [
            "42ba5a090b2bdeaa"
          ]
        },
        "sockopt": {
          "tcpFastOpen": true,
          "domainStrategy": "UseIPv4"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "vless-reality-xhttp",
      "listen": "127.0.0.1",
      "port": 10444,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "4ea33e69-8a88-4811-b1f7-e433b46b8f5a",
            "email": "user1-mobile@datalink"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "/api/v3/stream",
          "mode": "stream-one",
          "noSSEHeader": false,
          "xPaddingBytes": "100-1000"
        },
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.bing.com:443",
          "xver": 0,
          "serverNames": [
            "www.bing.com"
          ],
          "privateKey": "UOW9SYxgPjGBP1HkkUMFFAxs4we-8Q4MEFcbnNAZMlc",
          "shortIds": [
            "42ba5a090b2bdeaa"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "routeOnly": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:ru",
          "geoip:by",
          "geoip:kz"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "block"
      }
    ]
  }
}