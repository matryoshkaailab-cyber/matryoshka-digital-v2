{
  "id": 2,
  "name": "DATALINK VPN - YooKassa Webhook",
  "active": false,
  "nodes": [
    {
      "id": "11111111-1111-4111-1111-111111111111",
      "name": "YooKassa Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "path": "yookassa",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "22222222-2222-4222-2222-222222222222",
      "name": "Parse and Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [450, 300],
      "parameters": {
        "language": "python",
        "code": "import json\n\nitem = items[0]\nbody = item.get('json', {})\nevent = body.get('event', '')\nobj = body.get('object', {})\n\npayment_id = obj.get('id', '')\namount = obj.get('amount', {}).get('value', '0')\ncurrency = obj.get('amount', {}).get('currency', 'RUB')\nmetadata = obj.get('metadata', {})\nuser_id = metadata.get('user_id', '')\nperiod = metadata.get('period', 'month')\n\nif event != 'payment.succeeded':\n    return [{'json': {'error': 'Not payment.succeeded'}}]\n\nif not user_id:\n    return [{'json': {'error': 'No user_id in metadata'}}]\n\nreturn [{'json': {'payment_id': payment_id, 'amount': amount, 'currency': currency, 'user_id': str(user_id), 'period': period, 'status': 'paid'}}]"
      }
    },
    {
      "id": "33333333-3333-4333-3333-333333333333",
      "name": "Activate VPN",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [650, 300],
      "parameters": {
        "url": "http://localhost:4000/api/vpn/activate",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "user_id", "value": "={{ $json.user_id }}" },
            { "name": "period", "value": "={{ $json.period }}" },
            { "name": "payment_id", "value": "={{ $json.payment_id }}" }
          ]
        },
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Check Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "id": "0", "leftValue": "={{ $json.statusCode }}", "rightValue": "200", "operator": { "type": "number", "operation": "equals" } }
          ]
        }
      }
    }
  ],
  "connections": {
    "YooKassa Webhook": { "main": [[ { "node": "Parse and Validate", "type": "main", "index": 0 } ]] },
    "Parse and Validate": { "main": [[ { "node": "Activate VPN", "type": "main", "index": 0 } ]] },
